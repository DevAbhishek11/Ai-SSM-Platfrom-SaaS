NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:4000/api
WEB_BASE_URL=http://localhost:3000

# Comma-separated browser origins allowed to call the API directly.
# Defaults to WEB_BASE_URL when unset.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Web app -> API wiring.
# The browser calls the same-origin path below and Next.js proxies it to API_PROXY_TARGET,
# so the dashboard keeps working behind reverse proxies, containers, and preview URLs.
NEXT_PUBLIC_API_URL=/api
# Hosts allowed to POST Server Actions (CSRF boundary). Defaults to NEXT_ALLOWED_DEV_ORIGINS.
# Set this to your public dashboard host in production, e.g. app.example.com
NEXT_ALLOWED_SERVER_ACTION_ORIGINS=localhost:3000,127.0.0.1:3000
API_PROXY_TARGET=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000/api

DATABASE_URL=postgres://ssm:ssm@localhost:5432/ssm
REDIS_URL=redis://localhost:6379
# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
JWT_ISSUER=ssm-local
JWT_AUDIENCE=ssm-web
JWT_ACCESS_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_REGISTRATION_ENABLED=true
# Dev-only `x-user-role` header impersonation. MUST stay false outside local dev.
AUTH_ALLOW_DEV_HEADERS=false
ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
DATABASE_HEALTHCHECK=metadata
DEMO_USER_PASSWORD=demo-password-change-me

# Request throttling (per IP + route).
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_DISABLED=false

# Web sign-in screen conveniences (safe to leave unset in production).
NEXT_PUBLIC_DEMO_EMAIL=owner@acmegrowth.test
# Fixed display time zone: keeps server-rendered and browser-rendered
# timestamps identical, which avoids React hydration mismatches.
NEXT_PUBLIC_DISPLAY_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# AI model routing
# ---------------------------------------------------------------------------
# Providers activate purely from the credentials present below:
#   OLLAMA_BASE_URL   -> self-hosted Ollama (no API key needed)
#   ANTHROPIC_API_KEY -> Anthropic Claude
#   OPENAI_API_KEY    -> OpenAI
# With AI_PROVIDER=auto the router tries them in AI_PROVIDER_PRIORITY order and
# falls back to the built-in deterministic composer if none are configured or all fail.
AI_PROVIDER=auto
AI_PROVIDER_PRIORITY=ollama,anthropic,openai
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=900
AI_TEMPERATURE=0.7

OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_VERSION=2023-06-01

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

STRIPE_SECRET_KEY=
S3_BUCKET=
S3_REGION=
